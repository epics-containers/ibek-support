# Detect the first time the event link is online. Then set master enable.

record(calcout, "$(device):LINKENABLE")
{
	field(DESC, "Detect initial link up")
	field(INPA, "$(device):LINKSTAT")
	field(CALC, "A")
	field(OUT,  "$(device):ENABLE:S PP")
	field(OOPT, "Transition To Non-zero")
	field(ODLY, "1.0")
	field(SCAN, "1 second")
}

