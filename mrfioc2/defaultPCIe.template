# Diamond EVR template for the PCIe MRM-EVR-300 and IFB-300, from the Diamond
# mrfioc2 2-2-0dls6 (evrMrmApp/Db/defaultPCIe.template). The two CDR:ENABLE
# records are left out: they used the "CDR Enable" property that only the
# Diamond fork's driver has. The PUL1 setpoints' DESC reads "Pulse Generator 1"
# where the Diamond file says "Pulse Generator 0".
#
# default template for the PCIe MRM-EVR-300 and IFB-300

# macros:
# % macro, device, standard DLS device name, probably including EVR-0n
# % macro, evr,    name defined in the mrmEvrSetupPCI() function

record(bi, "$(device):LINKSTAT")
{
	field(DTYP, "Obj Prop bool")
	field(INP,  "@OBJ=$(evr), PROP=Link Status")
	field(DESC, "Status of event link")
	field(SCAN, "1 second")
	field(ZNAM, "Fail")
	field(ONAM, "OK")
	field(ZSV,  "MAJOR")
}

record(longin, "$(device):LINKERR")
{
	field(DTYP, "Obj Prop uint32")
	field(INP,  "@OBJ=$(evr), PROP=HB Timeout Count")
	field(SCAN, "I/O Intr")
	field(DESC, "# of heartbeat timeout")
}

record(longin, "$(device):RXERR")
{
	field(DTYP, "Obj Prop uint32")
	field(DESC, "Receive Error Count")
	field(INP,  "@OBJ=$(evr), PROP=Receive Error Count")
	field(SCAN, "1 second")
}

record(longin, "$(device):FIFOERR")
{
	field(DTYP, "Obj Prop uint32")
	field(DESC, "FIFO Hw Overflow Count")
	field(INP,  "@OBJ=$(evr), PROP=FIFO Overflow Count")
	field(SCAN, "1 second")
