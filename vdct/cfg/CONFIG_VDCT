# Settings for flattening VDCT .vdb files into .template files.
#
# EPICS base includes <top>/cfg/CONFIG* for every top named in a module's
# configure/RELEASE (see base configure/CONFIG, "Include <top>/cfg/CONFIG*
# definitions from tops defined in RELEASE* files"). EPICS_BASE is always
# such a top, so installing this file into <base>/cfg makes these settings
# visible to every module.

FLATDB = flatdb
FLATDB_FLAGS += --disable-macro-warnings

# Build ordering.
#
# A .vdb names the dbd it loads in a '#! DBD("...")' header, and that dbd is
# normally generated by a sibling source directory. Base only serialises
# subdirectories via <dir>_DEPEND_DIRS, so under make -j the Db directory can
# otherwise start flattening before the dbd exists - VisualDCT then reports
# "No DBD loaded! Exiting..." for every file.
#
# Setting this here rather than in RULES_VDCT is deliberate, and is the only
# thing that makes it global. <dir>_DEPEND_DIRS has to be set before the
# Makefile includes RULES_DIRS, because base expands it while defining the
# inter directory rules (DEP_template2 in configure/RULES_DIRS). RULES_DIRS
# does not include RULES_FILE_TYPE, so RULES_VDCT is never read at that level,
# whereas configure/CONFIG - which pulls in cfg/CONFIG* - is included by the
# App Makefile before RULES_DIRS. So a module needs no patching of its own.

# directories holding .vdb files, and the sibling source directories that
# generate dbds. The '/.' suffix restricts the wildcards to directories.
VDCT_VDB_DIRS := $(sort $(patsubst %/,%,$(dir $(wildcard */*.vdb))))
VDCT_SRC_DIRS := $(sort $(patsubst %/.,%,$(wildcard *src*/. *Src*/.)))

# Deferred (=) on purpose: this is expanded when RULES_DIRS defines the rules,
# by which time the Makefile has set DIRS. Filtering against DIRS means we can
# never make a directory depend on one that is not part of the build, which
# would fail with "No rule to make target 'src.install'".
$(foreach dir,$(VDCT_VDB_DIRS),$(eval \
    $(dir)_DEPEND_DIRS += $$(filter-out $(dir),$$(filter $$(VDCT_SRC_DIRS),$$(DIRS)))))
